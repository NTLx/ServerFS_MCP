# ============================================================
# ServerFS MCP
# ============================================================

# Docker image for the serverfs-mcp service (published to GHCR).
#
# Production: pin an exact published release so deploys are reproducible and rollback
# is a one-line change. v0.7.2 release target:
#   SERVERFS_IMAGE=ghcr.io/ntlx/serverfs_mcp:0.7.2
# Track development builds from main:
#   SERVERFS_IMAGE=ghcr.io/ntlx/serverfs_mcp:edge
# Building from source? Leave this as-is and run `docker compose build`.
SERVERFS_IMAGE=ghcr.io/ntlx/serverfs_mcp:latest

# Log level for the ServerFS MCP container (DEBUG / INFO / WARNING / ERROR)
SERVERFS_LOG_LEVEL=INFO

# Linux UID/GID the serverfs-mcp container runs as.
# The host directories you expose must be readable by this UID/GID.
# Docker's read-only bind mount does NOT bypass Linux file permissions.
# For the optional Phase E Agent Bridge deployment, set these to the current
# normal login user's `id -u` / `id -g` so the container requests the same
# identity as the host-side Bridge.
SERVERFS_UID=10001
SERVERFS_GID=10001

# ============================================================
# Optional Phase E Agent Bridge deployment
# ============================================================
#
# `.env` is the single deployment configuration source. The base compose.yml
# ignores these Agent-specific values; they become active only when the explicit
# compose.agent.yml overlay is used.
#
# Keep false for the default v0.2-compatible 11-tool deployment. Change to true
# only after SO_PEERCRED has been measured and the selected workdir/provider
# settings have been reviewed; then install and validate the host-side Bridge.
#
# SERVERFS_AGENT_MODE / SERVERFS_AGENT_RUNTIMES are the global Agent policy
# defaults inherited by workdirs whose WORKDIR_XX overrides are empty. They
# do NOT replace SERVERFS_AGENT_BRIDGE_ENABLED: the Bridge switch is still the
# infrastructure master gate.
SERVERFS_AGENT_BRIDGE_ENABLED=false
SERVERFS_AGENT_BRIDGE_TIMEOUT_SECONDS=30
SERVERFS_AGENT_MODE=disabled
SERVERFS_AGENT_RUNTIMES=

# Fill PEER_UID/GID only from deployment/agent-bridge/measure_peercred.py output.
# Never infer them from id -u/id -g. The measured values must equal the current
# login user for the default user-scoped Phase E deployment; otherwise fail closed.
SERVERFS_AGENT_PEER_UID=
SERVERFS_AGENT_PEER_GID=

# User-owned host runtime/state paths. Use absolute paths for the actual login user.
# Example: /home/me/.local/share/serverfs-agent-bridge/runtime/socket
SERVERFS_AGENT_BRIDGE_HOST_SOCKET_DIR=
SERVERFS_AGENT_LOCK_HOST_DIR=
SERVERFS_AGENT_BRIDGE_STATE_DIR=

# Provider executables are host-side only and must be absolute when enabled by a
# workdir Agent policy. Provider secrets/shell-only variables normally do NOT belong
# here; keep those in ~/.config/serverfs-agent-bridge/provider.env (mode 0600).
# Opt-in exception: SERVERFS_JEV_API_KEY is the master gate for the experimental
# advisory Jev features (Preflight, Runtime Router, Approval Advisor). Leave it empty
# to disable all Jev functionality.
SERVERFS_CODEX_BIN=
SERVERFS_CODEX_HOME=~/.codex
SERVERFS_CODEX_AUTOSTART=false
SERVERFS_CODEX_REQUEST_TIMEOUT_SECONDS=10
SERVERFS_CLAUDE_BIN=
SERVERFS_CLAUDE_PROBE_TIMEOUT_SECONDS=5
SERVERFS_JEV_API_KEY=

# read_text_file limits
SERVERFS_MAX_READ_BYTES=524288
SERVERFS_MAX_READ_LINES=500

# list_directory limits
SERVERFS_DEFAULT_LIST_LIMIT=100
SERVERFS_MAX_LIST_ENTRIES=500

# search limits (find_files / search_text)
SERVERFS_DEFAULT_SEARCH_RESULTS=50
SERVERFS_MAX_SEARCH_RESULTS=100

# find_files traversal cap (filesystem entries per call)
SERVERFS_MAX_WALK_ENTRIES=200000

# search_text: ripgrep wall-clock timeout and per-file size ceiling
SERVERFS_SEARCH_TIMEOUT_SECONDS=15
SERVERFS_SEARCH_MAX_FILE_BYTES=52428800

# Allow hidden (dot-prefixed) paths to be listed/read/searched.
# Credential-like files (.env, *.key, id_rsa, .ssh/**, ...) stay denied
# regardless of this setting (defense in depth).
SERVERFS_ALLOW_HIDDEN=false

# Extra deny globs: comma-separated filename patterns appended to the
# credential deny rules, applied on every channel (list/find/search/read/stat).
# Semantics: a plain glob (e.g. "*.sqlite") matches file/directory names;
# "dirname/**" (e.g. "internal/**") matches everything inside that directory.
# These rules always apply — including when SERVERFS_DISABLE_DEFAULT_DENY=true.
SERVERFS_EXTRA_DENY_GLOBS=

# Disable the built-in credential deny rules (.env, *.pem, *.key, id_rsa,
# .ssh/**, ...). Default false. WARNING: setting this to true lets the AI
# agent read credential material inside your workdirs — if you use it,
# define compensating rules via SERVERFS_EXTRA_DENY_GLOBS.
SERVERFS_DISABLE_DEFAULT_DENY=false

# Mutation limits (only apply to workdirs configured READ_ONLY=false).
# Max bytes for create_text_file content, an edited source file and an edit
# result; also caps the total size of all old_text+new_text in one call.
SERVERFS_MAX_WRITE_BYTES=1048576

# Max edits accepted in one edit_text_file call.
SERVERFS_MAX_EDITS_PER_CALL=50

# Binary transfer is opt-in. When disabled for every workdir, the binary
# upload/download tools are not registered at all. The whole-file transfer
# ceiling applies before/while decoding uploads and while reading downloads.
SERVERFS_BINARY_TRANSFER_ENABLED=false
SERVERFS_MAX_BINARY_TRANSFER_BYTES=8388608

# Optional ChatGPT/OpenAI file-parameter ingress. This does NOT give the
# serverfs-mcp container Internet access: it talks only to the isolated
# serverfs-file-ingress sidecar over an internal Docker network.
# Start the sidecar explicitly with the `file-ingress` Compose profile.
SERVERFS_FILE_INGRESS_ENABLED=false
SERVERFS_FILE_INGRESS_TIMEOUT_SECONDS=30

# Sidecar-only policy. ALLOWED_HOSTS is an exact comma-separated hostname
# allowlist: generic wildcards are never accepted. Real ChatGPT probes show that
# OpenAI fileParams can use region-varying Azure Blob storage accounts; opt in to
# only that measured account-name family with the separate boolean below.
SERVERFS_FILE_INGRESS_ALLOWED_HOSTS=
SERVERFS_FILE_INGRESS_ALLOW_OPENAI_BLOB_HOSTS=false
SERVERFS_FILE_INGRESS_MAX_BYTES=8388608
SERVERFS_FILE_INGRESS_FETCH_TIMEOUT_SECONDS=30
SERVERFS_FILE_INGRESS_MAX_REDIRECTS=3


# ============================================================
# Workdirs (16 slots)
# ============================================================
#
# Each slot has identity/mount fields plus optional policy overrides.
# Empty policy overrides inherit the matching SERVERFS_* global default.
# Scalar workdir overrides win over global defaults. EXTRA_DENY_GLOBS is the
# deliberate exception: global + workdir deny globs are UNIONED, so a workdir
# can tighten but cannot remove the global deny floor.
#
# Identity/mount:
#   ALIAS, PATH, DESCRIPTION, READ_ONLY
# Read policy overrides:
#   ALLOW_HIDDEN, DISABLE_DEFAULT_DENY, EXTRA_DENY_GLOBS
#   MAX_READ_BYTES, MAX_READ_LINES, MAX_WRITE_BYTES
# Binary policy overrides:
#   BINARY_TRANSFER_ENABLED, MAX_BINARY_TRANSFER_BYTES
# Agent policy overrides:
#   AGENT_MODE, AGENT_RUNTIMES
#
# Agent delegation still requires the optional compose.agent.yml overlay and
# SERVERFS_AGENT_BRIDGE_ENABLED=true. Native Codex/Claude currently require
# effective AGENT_MODE=workspace-write and READ_ONLY=false.
#
# Rules:
#   - alias: letter first, then letters/digits/_/-, max 32 chars
#   - alias must be unique across slots
#   - leave ALIAS and PATH empty to disable a slot
#   - host path must already exist (it is never auto-created)
#   - READ_ONLY accepts true/false (also 1/0, yes/no, on/off), but write it
#     as true or false: Docker Compose itself rejects 1 and 0 for the
#     matching bind-mount flag. An unknown value stops the container at
#     startup instead of guessing.
#   - READ_ONLY controls BOTH the ServerFS authorization and the Docker
#     bind mount, from this one variable. A read-write workdir needs the
#     ServerFS UID/GID to have write permission on the host directory.
#   - empty workdir policy fields inherit their SERVERFS_* global defaults;
#     explicit true/false or numeric overrides take precedence for that slot.
#   - AGENT_MODE/AGENT_RUNTIMES remain inert unless compose.agent.yml is used
#     with SERVERFS_AGENT_BRIDGE_ENABLED=true.
#   - Native Codex/Claude currently require effective AGENT_MODE=workspace-write
#     and READ_ONLY=false.
#   - BINARY_TRANSFER_ENABLED does not make a read-only workdir writable:
#     downloads may be allowed, but uploads still require READ_ONLY=false.
#
# Upgrading from v0.1: this variable did not exist, so every existing
# workdir stays read-only until you explicitly set it to false.

WORKDIR_01_ALIAS=projects
WORKDIR_01_PATH=/srv/projects
WORKDIR_01_DESCRIPTION="项目代码、部署配置和技术文档"
WORKDIR_01_READ_ONLY=true
WORKDIR_01_ALLOW_HIDDEN=
WORKDIR_01_DISABLE_DEFAULT_DENY=
WORKDIR_01_EXTRA_DENY_GLOBS=
WORKDIR_01_MAX_READ_BYTES=
WORKDIR_01_MAX_READ_LINES=
WORKDIR_01_MAX_WRITE_BYTES=
WORKDIR_01_BINARY_TRANSFER_ENABLED=
WORKDIR_01_MAX_BINARY_TRANSFER_BYTES=
WORKDIR_01_AGENT_MODE=
WORKDIR_01_AGENT_RUNTIMES=

WORKDIR_02_ALIAS=
WORKDIR_02_PATH=
WORKDIR_02_DESCRIPTION=
WORKDIR_02_READ_ONLY=true
WORKDIR_02_ALLOW_HIDDEN=
WORKDIR_02_DISABLE_DEFAULT_DENY=
WORKDIR_02_EXTRA_DENY_GLOBS=
WORKDIR_02_MAX_READ_BYTES=
WORKDIR_02_MAX_READ_LINES=
WORKDIR_02_MAX_WRITE_BYTES=
WORKDIR_02_BINARY_TRANSFER_ENABLED=
WORKDIR_02_MAX_BINARY_TRANSFER_BYTES=
WORKDIR_02_AGENT_MODE=
WORKDIR_02_AGENT_RUNTIMES=

WORKDIR_03_ALIAS=
WORKDIR_03_PATH=
