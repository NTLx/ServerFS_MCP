# ServerFS — Linux Docker configuration
# Reference template, not a ready-to-run deployment. See deployment/linux/README.md.
# Create a private mode-0600 env outside Git and exposed workdirs. Select only
# the components you need; keep unused capability switches disabled.
# Replace or clear the example workdir before starting. Never print expanded
# Compose configuration containing secrets. This template keeps existing
# assignment defaults for compatibility; pin verified artifacts explicitly.

# 1. Core image, identity and logging
# Pin the exact published version/digest or a verified local candidate tag.
# Build under a distinct scratch tag; never overwrite a production image tag.
SERVERFS_IMAGE=ghcr.io/ntlx/serverfs_mcp:latest
SERVERFS_UID=10001
SERVERFS_GID=10001
SERVERFS_LOG_LEVEL=INFO
TZ=Asia/Shanghai
# The nonroot UID/GID must have actual host directory permissions.

# 2. HTTP listener and publication
# Listener port is inside the container. Select compose.http.yml and the
# Linux publication overlay for direct HTTP, or the internal-only overlay.
# Publication defaults to loopback. A reverse proxy/TLS is operator-managed.
SERVERFS_HTTP_HOST=0.0.0.0
SERVERFS_HTTP_PORT=8000
SERVERFS_HTTP_PATH=/mcp
SERVERFS_HTTP_PUBLISH_HOST=127.0.0.1
SERVERFS_HTTP_PUBLISH_PORT=8000
# Empty Host allowlist derives serverfs-mcp:<HTTP_PORT>. Add exact authorities
# actually used by clients (including host-published port or public hostname).
# Empty Origin allowlist rejects nonempty Origin; add exact origins if needed.
SERVERFS_HTTP_ALLOWED_HOSTS=
SERVERFS_HTTP_ALLOWED_ORIGINS=
# Configure either API Key or OAuth for remote HTTP. Never publish unauthenticated
# MCP. Prefer Authorization: Bearer; ?key= is compatibility-only (URL log risk).
SERVERFS_HTTP_API_KEY=

# 3. Filesystem policy and limits
# Overrides in active WORKDIR_XX slots replace defaults. Extra deny globs
# are unioned; hidden access does not turn off built-in credential deny.
# Disabling built-in deny exposes potentially sensitive files: avoid it.
SERVERFS_ALLOW_HIDDEN=false
SERVERFS_EXTRA_DENY_GLOBS=
SERVERFS_DISABLE_DEFAULT_DENY=false
SERVERFS_MAX_READ_BYTES=524288
SERVERFS_MAX_READ_LINES=500
SERVERFS_DEFAULT_LIST_LIMIT=100
SERVERFS_MAX_LIST_ENTRIES=500
SERVERFS_DEFAULT_SEARCH_RESULTS=50
SERVERFS_MAX_SEARCH_RESULTS=100
SERVERFS_MAX_WALK_ENTRIES=200000
SERVERFS_SEARCH_TIMEOUT_SECONDS=15
SERVERFS_SEARCH_MAX_FILE_BYTES=52428800
SERVERFS_MAX_WRITE_BYTES=1048576
SERVERFS_MAX_EDITS_PER_CALL=50

# 4. Optional whole-file binary transfer and file ingress
# A slot may override binary enablement and raw-byte limit. Ingress fetch is
# additionally capped at the lower of the slot limit and sidecar global limit.
# Upload requires a writable workdir; the file-ingress profile and switch are
# both needed for file parameters. The sidecar is not a generic URL proxy.
SERVERFS_BINARY_TRANSFER_ENABLED=false
SERVERFS_MAX_BINARY_TRANSFER_BYTES=8388608
SERVERFS_FILE_INGRESS_ENABLED=false
SERVERFS_FILE_INGRESS_TIMEOUT_SECONDS=30
# Exact HTTPS hosts only; the separate switch admits a constrained OpenAI
# Blob host family. No generic wildcard. See the Binary Transfer guide.
SERVERFS_FILE_INGRESS_ALLOWED_HOSTS=
SERVERFS_FILE_INGRESS_ALLOW_OPENAI_BLOB_HOSTS=false
SERVERFS_FILE_INGRESS_FETCH_TIMEOUT_SECONDS=30
SERVERFS_FILE_INGRESS_MAX_REDIRECTS=3

# 5. Optional Cloudflare Connector
# Select the Cloudflare overlays/profile in the runbook, not a host port.
# External route targets http://serverfs-mcp:<HTTP_PORT>; Core admits its Host.
# Token file: absolute external path, 0600, readable by CLOUDFLARED_UID/GID.
# Token authenticates the Connector, not the caller. Pin a verified image.
CLOUDFLARED_UID=10001
CLOUDFLARED_GID=10001
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.7
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/absolute/private/cloudflare-token

# 6. Optional OpenAI Connector
# Named HTTP overlay/profile openai-http: separate external credential files,
# exact Tunnel ID and a verified tunnel-client image supporting HTTP flags.
# Core bearer file contains exactly "Bearer <Core API key>", no newline.
# Do not populate the legacy inline key for the named HTTP overlay.
OPENAI_TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.17
CONTROL_PLANE_BASE_URL=https://api.openai.com
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
# OPENAI_CONTROL_PLANE_KEY_FILE=/absolute/private/openai-control-plane.key
# SERVERFS_CORE_BEARER_FILE=/absolute/private/core-auth-header
# Inline CONTROL_PLANE_API_KEY and startup-wait setting are for the existing
# stdio Tunnel compatibility path; neither is required for direct HTTP.
MCP_STARTUP_WAIT_TIMEOUT=60s
TUNNEL_LOG_LEVEL=info
TUNNEL_LOG_FORMAT=json
HEALTH_LISTEN_ADDR=:8080

# 7. Optional OAuth (compose.oauth.yml)
# Alternative to API Key. Configure exact public resource/issuer HTTPS URLs
# (loopback HTTP only for tests), independent auth service and introspection
# secret. Do not enable the named static-bearer OpenAI HTTP path with OAuth.
SERVERFS_OAUTH_ENABLED=false
SERVERFS_OAUTH_RESOURCE_URL=
SERVERFS_OAUTH_ISSUER_URL=
SERVERFS_OAUTH_REQUIRED_SCOPES=serverfs:access
SERVERFS_OAUTH_INTROSPECTION_URL=http://serverfs-auth:8082/internal/introspect
SERVERFS_OAUTH_INTROSPECTION_SECRET=
SERVERFS_OAUTH_INTROSPECTION_TIMEOUT_SECONDS=2
# Auth service state must be writable by SERVERFS_UID/GID. Client JSON is
# optional, read-only; allowed principals are exact provider:stable-subject
# values, default deny. DCR is compatibility-only.
SERVERFS_AUTH_HOST=0.0.0.0
SERVERFS_AUTH_PORT=8082
SERVERFS_AUTH_PUBLIC_URL=
SERVERFS_AUTH_PUBLISH_HOST=127.0.0.1
SERVERFS_AUTH_PUBLISH_PORT=8082
SERVERFS_AUTH_STATE_HOST_DIR=./.serverfs-auth-state
SERVERFS_AUTH_STATE_DIR=/var/lib/serverfs-auth
SERVERFS_AUTH_CLIENTS_FILE=
SERVERFS_AUTH_ALLOWED_PRINCIPALS=
SERVERFS_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
SERVERFS_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
SERVERFS_AUTH_DCR_ENABLED=false
SERVERFS_AUTH_USE_PROXY=false
# Only for a separate public auth origin in compatible Tunnel OAuth.
MCP_OAUTH_TRUSTED_ORIGINS=
# Provider credentials belong only to auth. WeChat = Open Platform Website login.
SERVERFS_OAUTH_GITHUB_ENABLED=false
SERVERFS_OAUTH_GITHUB_CLIENT_ID=
SERVERFS_OAUTH_GITHUB_CLIENT_SECRET=
SERVERFS_OAUTH_DINGTALK_ENABLED=false
SERVERFS_OAUTH_DINGTALK_CLIENT_ID=
SERVERFS_OAUTH_DINGTALK_CLIENT_SECRET=
SERVERFS_OAUTH_FEISHU_ENABLED=false
SERVERFS_OAUTH_FEISHU_CLIENT_ID=
SERVERFS_OAUTH_FEISHU_CLIENT_SECRET=
SERVERFS_OAUTH_WECHAT_ENABLED=false
SERVERFS_OAUTH_WECHAT_CLIENT_ID=
SERVERFS_OAUTH_WECHAT_CLIENT_SECRET=

# 8. Optional host Bridge
# New named Linux deployments: choose compose.bridge-v2.yml with owner-provisioned
# signed binding; otherwise choose compose.bridge-disabled.yml. Agent and Repo
# Ops are independent. v0.25.0 binds one active alias in slot 01; the v0.26.0
# candidate supports 1–16 explicitly granted aliases in slots 01–16.
# Additional disjoint file-only slots are allowed.
# Core ID and Bridge ID are distinct, nondefault IDs. Private directories and
# signed grants must be provisioned first. See the Linux runbook.
# SERVERFS_LINUX_INSTANCE_ID=core-blue
# SERVERFS_LINUX_BRIDGE_ID=bridge-blue
# SERVERFS_LINUX_BRIDGE_SOCKET_DIR=/absolute/private/bridge/run
# SERVERFS_LINUX_BRIDGE_LOCK_DIR=/absolute/private/bridge/locks
# SERVERFS_LINUX_CORE_BINDING_DIR=/absolute/private/core-binding
# The overlay sets infrastructure enabled; keep global policy disabled and
# opt in only at slots authorized by the Bridge owner and matching binding.
SERVERFS_AGENT_BRIDGE_ENABLED=false
SERVERFS_AGENT_BRIDGE_TIMEOUT_SECONDS=30
SERVERFS_AGENT_MODE=disabled
SERVERFS_AGENT_RUNTIMES=
# For the existing user-scoped compose.agent.yml compatibility path, the
# selected env file is the single deployment configuration source for Core and
# rendered Bridge policy. Provider-native shell settings belong in the private
# provider.env. The named v2 owner uses its own explicit policy JSON; these
# fields do not automatically reconfigure it.
SERVERFS_AGENT_TASK_TIMEOUT_SECONDS=7200
SERVERFS_AGENT_INTERACTION_TIMEOUT_SECONDS=1800
SERVERFS_AGENT_MAX_ACTIVE_TASKS=4
SERVERFS_AGENT_TASK_RETENTION_HOURS=168
SERVERFS_AGENT_RESULT_SPOOL_THRESHOLD_BYTES=262144
# Inline result default 256 KiB; maximum spooled result 8 MiB.
# For the compatibility path, use deployment/agent-bridge/measure_peercred.py
# to measure actual SO_PEERCRED; do not infer it from id -u/id -g.
# Require the expected host login UID/GID.
SERVERFS_AGENT_PEER_UID=
SERVERFS_AGENT_PEER_GID=
SERVERFS_AGENT_BRIDGE_HOST_SOCKET_DIR=
SERVERFS_AGENT_LOCK_HOST_DIR=
SERVERFS_AGENT_BRIDGE_STATE_DIR=
# Host provider executables must be absolute when enabled; provider credentials
# stay in provider-owned private state, not the Core. ACP profile JSON fixes
# command and argv; Agent runtimes require workspace-write and read_only=false.
SERVERFS_ACP_PROFILES_JSON=
SERVERFS_CODEX_BIN=
SERVERFS_CODEX_HOME=~/.codex
SERVERFS_CODEX_AUTOSTART=false
SERVERFS_CODEX_REQUEST_TIMEOUT_SECONDS=10
SERVERFS_CLAUDE_BIN=
SERVERFS_CLAUDE_PROBE_TIMEOUT_SECONDS=5
SERVERFS_QODER_BIN=
SERVERFS_QODER_PROBE_TIMEOUT_SECONDS=5
# Optional advisory-only Jev key belongs to the Bridge, never the Core.
SERVERFS_JEV_API_KEY=

# 9. Optional egress proxy
# Each switch controls only its component. Agent proxy must be credentialless;
# use a local broker for authenticated upstreams. Named owners need their own
# explicit runtime configuration; these values do not configure Docker daemon.
SERVERFS_OPENAI_TUNNEL_USE_PROXY=false
SERVERFS_AGENT_USE_PROXY=false
SERVERFS_JEV_USE_PROXY=false
SERVERFS_PROXY_HOST=
SERVERFS_PROXY_PORT=
SERVERFS_PROXY_USERNAME=
SERVERFS_PROXY_PASSWORD=

# 10. Workdirs (16 slots)
# Required for an active slot: unique alias (letter first, letters/digits/_/-,
# <=32), existing absolute host path. Leave alias/path empty for unused slots.
# READ_ONLY controls Core policy AND the Docker mount; keep true unless needed.
# Empty scalar policies inherit globals; Repo Ops defaults false per slot.
# EXTRA_DENY_GLOBS unions with global rules. Named actions are fixed operator
# policy, not arbitrary command execution; require writable root, integrity
# pins and exclusive writer lease even when mutates=false.
# Agent runtime allowlist requires workspace-write and READ_ONLY=false.
# v0.25.0 signed named attachment uses slot 01 only; the v0.26.0 candidate
# supports explicitly granted slots 01–16. Ungranted slots are file-only or
# disabled. Keep roots disjoint. See Repo Ops and Agent Bridge guides.
# Replace the example slot 01 with the directory you actually intend to expose.

WORKDIR_01_ALIAS=projects
WORKDIR_01_PATH=/srv/projects
WORKDIR_01_DESCRIPTION="项目代码、部署配置和技术文档"
WORKDIR_01_READ_ONLY=true
WORKDIR_01_ALLOW_HIDDEN=
WORKDIR_01_DISABLE_DEFAULT_DENY=
WORKDIR_01_EXTRA_DENY_GLOBS=
WORKDIR_01_MAX_READ_BYTES=
WORKDIR_01_MAX_READ_LINES=
WORKDIR_01_MAX_WRITE_BYTES=
WORKDIR_01_BINARY_TRANSFER_ENABLED=
WORKDIR_01_MAX_BINARY_TRANSFER_BYTES=
WORKDIR_01_REPO_OPS_ENABLED=
WORKDIR_01_REPO_ACTIONS_JSON=
WORKDIR_01_AGENT_MODE=
WORKDIR_01_AGENT_RUNTIMES=

WORKDIR_02_ALIAS=
WORKDIR_02_PATH=
WORKDIR_02_DESCRIPTION=
WORKDIR_02_READ_ONLY=true
WORKDIR_02_ALLOW_HIDDEN=
WORKDIR_02_DISABLE_DEFAULT_DENY=
WORKDIR_02_EXTRA_DENY_GLOBS=
WORKDIR_02_MAX_READ_BYTES=
WORKDIR_02_MAX_READ_LINES=
WORKDIR_02_MAX_WRITE_BYTES=
