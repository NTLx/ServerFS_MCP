# ============================================================
# ServerFS MCP
# ============================================================

# Docker image name for the serverfs-mcp service
SERVERFS_IMAGE=serverfs-mcp:0.1.0

# Log level for the ServerFS MCP container (DEBUG / INFO / WARNING / ERROR)
SERVERFS_LOG_LEVEL=INFO

# Linux UID/GID the serverfs-mcp container runs as.
# The host directories you expose must be readable by this UID/GID.
# Docker's read-only bind mount does NOT bypass Linux file permissions.
SERVERFS_UID=10001
SERVERFS_GID=10001

# read_text_file limits
SERVERFS_MAX_READ_BYTES=524288
SERVERFS_MAX_READ_LINES=500

# list_directory limits
SERVERFS_DEFAULT_LIST_LIMIT=100
SERVERFS_MAX_LIST_ENTRIES=500

# search limits (find_files / search_text)
SERVERFS_DEFAULT_SEARCH_RESULTS=50
SERVERFS_MAX_SEARCH_RESULTS=100

# find_files traversal cap (filesystem entries per call)
SERVERFS_MAX_WALK_ENTRIES=200000

# search_text: ripgrep wall-clock timeout and per-file size ceiling
SERVERFS_SEARCH_TIMEOUT_SECONDS=15
SERVERFS_SEARCH_MAX_FILE_BYTES=52428800

# Allow hidden (dot-prefixed) paths to be listed/read/searched.
# Credential-like files (.env, *.key, id_rsa, .ssh/**, ...) stay denied
# regardless of this setting (defense in depth).
SERVERFS_ALLOW_HIDDEN=false


# ============================================================
# Workdirs (16 slots)
# ============================================================
#
# Each slot: ALIAS is the name the AI agent sees; PATH is the host
# directory to expose read-only; DESCRIPTION is optional.
#
# Rules:
#   - alias: letter first, then letters/digits/_/-, max 32 chars
#   - alias must be unique across slots
#   - leave ALIAS and PATH empty to disable a slot
#   - host path must already exist (it is never auto-created)

WORKDIR_01_ALIAS=projects
WORKDIR_01_PATH=/srv/projects
WORKDIR_01_DESCRIPTION="项目代码、部署配置和技术文档"

WORKDIR_02_ALIAS=
WORKDIR_02_PATH=
WORKDIR_02_DESCRIPTION=

WORKDIR_03_ALIAS=
WORKDIR_03_PATH=
WORKDIR_03_DESCRIPTION=

WORKDIR_04_ALIAS=
WORKDIR_04_PATH=
WORKDIR_04_DESCRIPTION=

WORKDIR_05_ALIAS=
WORKDIR_05_PATH=
WORKDIR_05_DESCRIPTION=

WORKDIR_06_ALIAS=
WORKDIR_06_PATH=
WORKDIR_06_DESCRIPTION=

WORKDIR_07_ALIAS=
WORKDIR_07_PATH=
WORKDIR_07_DESCRIPTION=

WORKDIR_08_ALIAS=
WORKDIR_08_PATH=
WORKDIR_08_DESCRIPTION=

WORKDIR_09_ALIAS=
WORKDIR_09_PATH=
WORKDIR_09_DESCRIPTION=

WORKDIR_10_ALIAS=
WORKDIR_10_PATH=
WORKDIR_10_DESCRIPTION=

WORKDIR_11_ALIAS=
WORKDIR_11_PATH=
WORKDIR_11_DESCRIPTION=

WORKDIR_12_ALIAS=
WORKDIR_12_PATH=
WORKDIR_12_DESCRIPTION=

WORKDIR_13_ALIAS=
WORKDIR_13_PATH=
WORKDIR_13_DESCRIPTION=

WORKDIR_14_ALIAS=
WORKDIR_14_PATH=
WORKDIR_14_DESCRIPTION=

WORKDIR_15_ALIAS=
WORKDIR_15_PATH=
WORKDIR_15_DESCRIPTION=

WORKDIR_16_ALIAS=
WORKDIR_16_PATH=
WORKDIR_16_DESCRIPTION=


# ============================================================
# OpenAI Secure MCP Tunnel
# ============================================================

# Official OpenAI tunnel-client image (pinned; do not use latest)
OPENAI_TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.14

# Create the tunnel in the OpenAI dashboard first, then paste:
CONTROL_PLANE_BASE_URL=https://api.openai.com

CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# How long the tunnel client waits for the MCP server to accept connections
MCP_STARTUP_WAIT_TIMEOUT=60s

# Tunnel client logging / ops endpoints (not published to the host)
TUNNEL_LOG_LEVEL=info
TUNNEL_LOG_FORMAT=json

HEALTH_LISTEN_ADDR=:8080


# ============================================================
# Runtime
# ============================================================

TZ=Asia/Shanghai
