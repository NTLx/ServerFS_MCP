---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090b10" />
    <title>404 — ServerFS MCP</title>
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        display: grid;
        min-height: 100vh;
        margin: 0;
        place-items: center;
        overflow: hidden;
        background:
          radial-gradient(circle at 50% 20%, rgba(111, 129, 232, 0.14), transparent 32rem),
          #090b10;
        color: #eef1f7;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(circle at center, black, transparent 72%);
        pointer-events: none;
      }
      main {
        position: relative;
        width: min(calc(100% - 40px), 720px);
        padding: 64px;
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 18px;
        background: rgba(15,18,27,.72);
        box-shadow: 0 36px 100px rgba(0,0,0,.35);
        text-align: center;
      }
      .code {
        margin: 0 0 22px;
        color: #9cabff;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 12px;
        letter-spacing: .16em;
      }
      h1 {
        margin: 0;
        font-size: clamp(4.5rem, 16vw, 9rem);
        line-height: .9;
        letter-spacing: -.08em;
      }
      p {
        max-width: 480px;
        margin: 28px auto 32px;
        color: #8f99aa;
        font-size: 15px;
        line-height: 1.7;
      }
      a {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        padding: 0 17px;
        border: 1px solid #c7ceff;
        border-radius: 9px;
        background: #d5daff;
        color: #111521;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
      }
      .hint {
        position: absolute;
        right: 18px;
        bottom: 15px;
        color: #465064;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 8px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="code">PATH_NOT_FOUND</div>
      <h1>404</h1>
      <p>
        This path is outside the exposed surface. Return to the ServerFS project site or
        use the documentation navigation to continue.
      </p>
      <a href={base}>Back to ServerFS</a>
      <span class="hint">no escape · by design</span>
    </main>
  </body>
</html>
