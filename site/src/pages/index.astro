---
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
const local = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const surfaces = [
  { count: '11', label: 'Filesystem', detail: 'safe read + guarded mutation surface' },
  { count: '13', label: '+ Binary', detail: 'bounded whole-file transfer' },
  { count: '19', label: '+ Agent', detail: 'structured Codex / Claude delegation' },
  { count: '21', label: 'Full surface', detail: 'binary + Agent Bridge enabled' },
];

const guarantees = [
  'Read-only by default',
  'No shell or generic executor',
  'Scoped workdir boundary',
  'Revision-guarded mutation',
  'No recursive delete',
  'Transport Host / Origin validation',
  'Internal-only MCP network',
  'Agent Bridge is opt-in',
];

const layers = [
  ['01', 'ChatGPT', 'Calls narrow MCP tools'],
  ['02', 'Secure MCP Tunnel', 'Outbound-only control-plane connection'],
  ['03', 'ServerFS MCP', 'Policy, path confinement, revisions, audit'],
  ['04', 'Docker boundary', 'No published ports · no Internet egress'],
  ['05', 'Scoped workdirs', 'Read-only unless explicitly released'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="ServerFS MCP securely exposes selected Linux directories as controlled workdirs to ChatGPT and AI agents."
    />
    <meta name="theme-color" content="#090b10" />
    <link rel="icon" type="image/svg+xml" href={local('favicon.svg')} />
    <title>ServerFS MCP — Your filesystem, safely exposed to AI</title>
  </head>
  <body>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href={local()} aria-label="ServerFS MCP home">
        <span class="brand-mark" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
        <span>ServerFS</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href={local('docs/')}>Docs</a>
        <a href="#architecture">Architecture</a>
        <a href="#security">Security</a>
        <a
          class="github-link"
          href="https://github.com/NTLx/ServerFS_MCP"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <a
            class="release-pill"
            href="https://github.com/NTLx/ServerFS_MCP/releases/tag/v0.4.0"
            target="_blank"
            rel="noreferrer"
          >
            <span class="live-dot"></span>
            v0.4.0 released
            <span aria-hidden="true">→</span>
          </a>

          <p class="eyebrow">SECURE MCP FOR LINUX WORKDIRS</p>
          <h1>Your filesystem.<br /><span>Safely exposed to AI.</span></h1>
          <p class="hero-lede">
            ServerFS gives ChatGPT and AI agents precise access to the Linux directories you
            choose — read-only by default, with opt-in mutations, binary transfer, and a
            structured Codex / Claude Agent Bridge.
          </p>

          <div class="hero-actions">
            <a class="button primary" href={local('docs/getting-started/')}>Get started</a>
            <a
              class="button secondary"
              href="https://github.com/NTLx/ServerFS_MCP"
              target="_blank"
              rel="noreferrer"
            >
              View source <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="trust-line" aria-label="Core guarantees">
            <span>No shell</span>
            <span>No escape</span>
            <span>Scoped writes</span>
            <span>MIT licensed</span>
          </div>
        </div>

        <div class="hero-system" aria-label="ServerFS architecture overview">
          <div class="system-grid" aria-hidden="true"></div>
          <div class="system-label top-label">AI CLIENT</div>

          <div class="node node-chatgpt">
            <span class="node-icon">✦</span>
            <div>
              <strong>ChatGPT</strong>
              <small>MCP client</small>
            </div>
          </div>

          <div class="beam beam-one" aria-hidden="true"><span></span></div>

          <div class="node node-tunnel">
            <span class="node-icon">⇅</span>
            <div>
              <strong>Secure MCP Tunnel</strong>
              <small>outbound only</small>
            </div>
          </div>

          <div class="beam beam-two" aria-hidden="true"><span></span></div>

          <div class="server-card">
            <div class="server-head">
              <span class="server-led"></span>
              <strong>ServerFS MCP</strong>
              <code>v0.4.0</code>
            </div>
            <div class="server-row">
              <span>filesystem</span>
              <em>scoped</em>
            </div>
            <div class="server-row">
              <span>mutations</span>
              <em>revision guarded</em>
            </div>
            <div class="server-row">
              <span>binary I/O</span>
              <em>bounded</em>
            </div>
            <div class="server-row">
              <span>Agent Bridge</span>
              <em>optional</em>
            </div>
          </div>

          <div class="side-path side-left">
            <div class="micro-node">
              <strong>Workdirs</strong>
              <small>/srv/projects</small>
            </div>
          </div>

          <div class="side-path side-right">
            <div class="micro-node">
              <strong>Agent Bridge</strong>
              <small>Codex · Claude</small>
            </div>
          </div>

          <div class="system-footer">
            <span><i class="ok"></i> internal network</span>
            <span><i class="ok"></i> no published ports</span>
          </div>
        </div>
      </section>

      <section class="capability-strip shell" aria-label="Capability surfaces">
        {surfaces.map((surface, index) => (
          <article class:list={['cap-card', { active: index === 3 }]}>
            <div class="cap-top">
              <strong>{surface.count}</strong>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h2>{surface.label}</h2>
            <p>{surface.detail}</p>
          </article>
        ))}
      </section>

      <section class="section shell" id="architecture">
        <div class="section-heading">
          <p class="eyebrow">ARCHITECTURE</p>
          <h2>Capability, not ambient authority.</h2>
          <p>
            Every layer has one job. Optional powers are explicit, narrow, and independently
            gated.
          </p>
        </div>

        <div class="architecture-layout">
          <div class="layer-stack">
            {layers.map(([number, title, detail]) => (
              <div class="layer-row">
                <span class="layer-number">{number}</span>
                <div>
                  <strong>{title}</strong>
                  <small>{detail}</small>
                </div>
                <span class="layer-state">BOUND</span>
              </div>
            ))}
          </div>

          <aside class="principle-card">
            <p class="mini-label">DESIGN PRINCIPLE</p>
            <blockquote>
              “Give the model the smallest useful primitive — never a general-purpose escape
              hatch.”
            </blockquote>
            <div class="principle-tags">
              <span>openat(2)</span>
              <span>O_NOFOLLOW</span>
              <span>atomic publish</span>
              <span>revision CAS</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section shell" id="security">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">DEFENSE IN DEPTH</p>
            <h2>Security is the architecture.</h2>
          </div>
          <p>
            ServerFS does not rely on one sandbox or one network assumption. Filesystem policy,
            transport validation, container isolation, and Agent boundaries reinforce each other.
          </p>
        </div>

        <div class="security-grid">
          {guarantees.map((item, index) => (
            <div class="security-item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{item}</p>
              <i aria-hidden="true">✓</i>
            </div>
          ))}
        </div>
      </section>

      <section class="section shell agent-section">
        <div class="agent-copy">
          <p class="eyebrow">OPTIONAL AGENT BRIDGE</p>
          <h2>Native agents stay on the host.</h2>
          <p>
            ServerFS brokers structured tasks over a user-owned Unix socket. Codex and Claude
            keep their native environment; the MCP container never becomes a generic host shell.
          </p>
          <a class="text-link" href={local('docs/agent-bridge/')}>
            Explore Agent Bridge <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="agent-diagram" aria-label="Agent Bridge data path">
          <div class="agent-box muted-box">
            <small>MCP CONTAINER</small>
            <strong>ServerFS</strong>
          </div>
          <div class="agent-link"><span></span><code>bridge.sock</code></div>
          <div class="agent-box bridge-box">
            <small>HOST USER SERVICE</small>
            <strong>Agent Bridge</strong>
            <div class="runtime-list">
              <span><i></i> Codex</span>
              <span><i></i> Claude</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section shell quickstart-section">
        <div class="terminal">
          <div class="terminal-bar">
            <span class="terminal-dots"><i></i><i></i><i></i></span>
            <span>serverfs · quick start</span>
            <span></span>
          </div>
          <pre><code><span class="prompt">$</span> git clone https://github.com/NTLx/ServerFS_MCP.git
<span class="prompt">$</span> cd ServerFS_MCP
<span class="prompt">$</span> cp .env.example .env
<span class="prompt">$</span> docker compose pull
<span class="prompt">$</span> docker compose up -d

<span class="success">✓ serverfs-mcp      healthy</span>
<span class="success">✓ openai-tunnel     connected</span></code></pre>
        </div>

        <div class="quickstart-copy">
          <p class="eyebrow">SELF-HOSTED</p>
          <h2>One Compose stack.<br />Your machine. Your policy.</h2>
          <p>
            Start with the 11-tool filesystem surface. Add binary transfer or the Agent Bridge
            only when the deployment actually needs them.
          </p>
          <a class="button secondary" href={local('docs/getting-started/')}>Read the deployment guide</a>
        </div>
      </section>

      <section class="final-cta shell">
        <div>
          <p class="eyebrow">SERVERFS MCP</p>
          <h2>Make your server legible to AI.<br /><span>Keep the boundary explicit.</span></h2>
        </div>
        <div class="cta-actions">
          <a class="button primary" href={local('docs/')}>Read the docs</a>
          <a
            class="button secondary"
            href="https://github.com/NTLx/ServerFS_MCP"
            target="_blank"
            rel="noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <div class="brand footer-brand">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ServerFS</span>
      </div>
      <p>Secure MCP access to explicitly configured Linux workdirs.</p>
      <div>
        <a href={local('docs/')}>Docs</a>
        <a href="https://github.com/NTLx/ServerFS_MCP">Source</a>
        <a href="https://github.com/NTLx/ServerFS_MCP/releases">Releases</a>
      </div>
    </footer>
  </body>
</html>
