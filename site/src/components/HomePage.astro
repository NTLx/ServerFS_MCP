---
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/home.css';

interface Props {
  locale: 'en' | 'zh-cn';
}

const { locale } = Astro.props;
const isZh = locale === 'zh-cn';

const copy = {
  en: {
    lang: 'en',
    title: 'ServerFS MCP — Controlled Linux filesystem access for AI',
    description:
      'ServerFS MCP securely exposes selected Linux directories as controlled workdirs to ChatGPT and AI agents.',
    nav: { docs: 'Docs', architecture: 'Architecture', security: 'Security' },
    languageSwitch: '简中',
    languageLabel: '切换到简体中文',
    release: 'v0.7.2',
    heroEyebrow: 'SECURE MCP FOR LINUX WORKDIRS',
    headline: ['Give AI access.', 'Keep the boundary explicit.'],
    lede:
      'Expose only the Linux workdirs you choose. Read-only by default, with guarded writes, bounded binary transfer, isolated ChatGPT file ingress, and an optional native Agent Bridge.',
    getStarted: 'Get started',
    viewSource: 'View source',
    guaranteesShort: ['No shell', 'No escape', 'Scoped writes', 'MIT licensed'],
    diagramLabel: 'CONTROLLED DATA PATH',
    mcpClient: 'MCP client',
    outboundOnly: 'outbound only',
    serverRows: [
      ['FILESYSTEM', 'scoped workdirs'],
