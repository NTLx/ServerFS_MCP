---
import '@fontsource-variable/noto-sans-sc/wght.css';
import '../styles/home.css';

interface Props {
  locale: 'en' | 'zh-cn';
}

const { locale } = Astro.props;
const isZh = locale === 'zh-cn';

const copy = {
  en: {
    lang: 'en',
    title: 'ServerFS MCP — Controlled filesystem access for AI on Linux and Windows',
    description:
      'ServerFS MCP securely exposes selected directories as controlled workdirs to ChatGPT and AI agents on Linux and Windows.',
    nav: { docs: 'Docs', architecture: 'Architecture', security: 'Security' },
    languageSwitch: '简中',
    languageLabel: '切换到简体中文',
    release: 'v0.10.0',
    heroEyebrow: 'SECURE MCP FOR LINUX AND WINDOWS WORKDIRS',
    headline: ['Give AI access.', 'Keep the boundary explicit.'],
    lede:
      'Expose selected workdirs on Linux and Windows. Read-only by default, with guarded writes and bounded binary transfer on both platforms. Isolated ChatGPT file ingress and the host Agent Bridge are optional Linux deployment features, not Windows v0.10 features.',
    getStarted: 'Get started',
    viewSource: 'View source',
    guaranteesShort: ['No shell', 'No escape', 'Scoped writes', 'MIT licensed'],
    diagramLabel: 'CONTROLLED DATA PATH',
    mcpClient: 'MCP client',
    outboundOnly: 'outbound only',
    serverRows: [
      ['FILESYSTEM', 'scoped workdirs'],
      ['MUTATIONS', 'revision guarded'],
      ['BINARY I/O', 'bounded · optional'],
      ['AGENT BRIDGE', 'Linux host · optional'],
    ],
    workdirs: 'Scoped Workdirs',
    workdirDefault: 'read-only by default',
    userSocket: 'user-owned socket',
    internalNetwork: 'Linux: internal network',
    noPorts: 'Windows: stdio · no MCP listener',
    surfacesLabel: 'Capability surfaces',
    capabilityEyebrow: 'PROGRESSIVE CAPABILITY',
    capabilityTitle: 'Start narrow. Expand deliberately.',
    capabilityBody:
      'ServerFS grows by explicit opt-in. Each added surface is bounded, independently gated, and visible in the tool contract.',
    surfaces: [
      { count: '11', label: 'Filesystem', detail: 'safe read + guarded mutation surface' },
      { count: '13', label: '+ Binary', detail: 'bounded whole-file transfer' },
      { count: '21', label: '+ Agent', detail: 'Linux host delegation + model discovery' },
      { count: '23', label: 'Full surface', detail: 'binary + Linux Agent Bridge enabled' },
    ],
    architectureEyebrow: 'ARCHITECTURE',
    architectureTitle: 'Capability, not ambient authority.',
    architectureBody:
      'Every layer has one job. Optional powers are explicit, narrow, and independently gated.',
    layers: [
      ['01', 'ChatGPT', 'Calls narrow MCP tools'],
      ['02', 'Secure MCP Tunnel', 'Outbound-only control-plane connection'],
      ['03', 'ServerFS MCP', 'Policy, path confinement, revisions, audit'],
      ['04', 'Deployment boundary', 'Linux Docker · Windows native stdio'],
      ['05', 'Scoped workdirs', 'Read-only unless explicitly released'],
    ],
    bound: 'BOUND',
    principleLabel: 'DESIGN PRINCIPLE',
    principle:
      '“Give the model the smallest useful primitive — never a general-purpose escape hatch.”',
    securityEyebrow: 'SECURITY BY CONSTRUCTION',
    securityTitle: 'Security is the shape of the interface.',
    securityBody:
      'ServerFS does not rely on one sandbox or one network assumption. Filesystem policy, transport validation, deployment isolation, and Agent boundaries reinforce each other.',
    securityStatement: 'Narrow primitives. Explicit boundaries. No ambient authority.',
    guarantees: [
      'Read-only by default',
      'No shell or generic executor',
      'Scoped workdir boundary',
      'Revision-guarded mutation',
      'No recursive delete',
      'Transport Host / Origin validation',
      'No public MCP listener',
      'Agent Bridge is opt-in',
    ],
    agentEyebrow: 'OPTIONAL AGENT BRIDGE',
    agentTitle: 'Native agents stay on the host.',
    agentBody:
      'The optional Agent Bridge is a Linux deployment feature; Windows v0.10 does not include Agent Bridge. On Linux, ServerFS brokers structured tasks over a user-owned Unix socket. Codex, Claude and Qoder keep native defaults; v0.9 adds model discovery and request-scoped overrides, while optional Jev advisors add pre-submit model advice without becoming execution authority.',
    exploreAgent: 'Explore Agent Bridge',
    exploreJev: 'Explore Jev Advisors',
    mcpContainer: 'MCP CONTAINER',
    hostService: 'HOST USER SERVICE',
    advisoryOnly: 'ADVISORY ONLY',
    policyDecides: 'policy decides',
    quickStartBar: 'serverfs · quick start',
    selfHosted: 'SELF-HOSTED',
    quickTitleLine1: 'One controlled service.',
    quickTitleLine2: 'Your machine. Your policy.',
    quickBody:
      'Start with the 11-tool filesystem surface. Add binary transfer on Linux or Windows; isolated ChatGPT file ingress, the Agent Bridge, and host-side Jev advisors are optional Linux deployment features.',
    readDeployment: 'Read the deployment guide',
    finalTitleLine1: 'Make your server legible to AI.',
    finalTitleLine2: 'Keep the boundary explicit.',
    readDocs: 'Read the docs',
    footer: 'Secure MCP access to explicitly configured workdirs on Linux and Windows.',
    footerDocs: 'Docs',
    footerSource: 'Source',
    footerReleases: 'Releases',
  },
  'zh-cn': {
    lang: 'zh-CN',
    title: 'ServerFS MCP — 让 AI 在 Linux 和 Windows 上受控访问文件系统',
    description:
      'ServerFS MCP 在 Linux 和 Windows 上将你明确指定的目录以受控 workdir 的形式安全开放给 ChatGPT 和 AI Agent。',
    nav: { docs: '文档', architecture: '架构', security: '安全' },
    languageSwitch: 'EN',
    languageLabel: 'Switch to English',
    release: 'v0.10.0',
    heroEyebrow: '面向 Linux 与 Windows Workdir 的安全 MCP',
    headline: ['让 AI 访问服务器。', '让边界始终明确。'],
    lede:
      '在 Linux 和 Windows 上只开放你明确指定的 workdir。两种平台均默认只读，并支持受控写入与有界二进制传输。隔离的 ChatGPT 文件入口和宿主机 Agent Bridge 是可选的 Linux 部署能力，不属于 Windows v0.10。',
    getStarted: '快速开始',
    viewSource: '查看源码',
    guaranteesShort: ['无 Shell', '无法越界', '受控写入', 'MIT 许可'],
    diagramLabel: '受控数据路径',
    mcpClient: 'MCP 客户端',
    outboundOnly: '仅出站连接',
    serverRows: [
      ['文件系统', '限定 workdir'],
      ['写入操作', 'revision 保护'],
      ['二进制 I/O', '有界 · 可选'],
      ['AGENT BRIDGE', 'Linux 宿主机 · 可选'],
    ],
    workdirs: '限定 Workdirs',
    workdirDefault: '默认只读',
    userSocket: '用户自有 socket',
    internalNetwork: 'Linux：仅内部网络',
    noPorts: 'Windows：stdio · 无 MCP 监听端口',
    surfacesLabel: '能力面',
    capabilityEyebrow: '渐进式能力',
    capabilityTitle: '从最小能力开始，按需扩展。',
    capabilityBody:
      'ServerFS 的能力通过显式 opt-in 逐层增加；每一层都范围受限、独立门控，并直接体现在工具契约中。',
    surfaces: [
      { count: '11', label: '文件系统', detail: '安全读取 + 受控写入能力面' },
      { count: '13', label: '+ 二进制', detail: '有界的整文件传输' },
      { count: '21', label: '+ Agent', detail: 'Linux 宿主机委派 + 模型发现' },
      { count: '23', label: '完整能力面', detail: '二进制 + Linux Agent Bridge' },
    ],
    architectureEyebrow: '架构',
    architectureTitle: '提供能力，而不是环境权限。',
    architectureBody:
      '每一层只做一件事。所有可选能力都显式启用、范围受限，并由独立策略门控。',
    layers: [
      ['01', 'ChatGPT', '调用窄能力 MCP 工具'],
      ['02', 'Secure MCP Tunnel', '仅出站的控制平面连接'],
      ['03', 'ServerFS MCP', '策略、路径约束、revision 与审计'],
      ['04', '部署边界', 'Linux Docker · Windows 原生 stdio'],
      ['05', '限定 Workdirs', '除非显式放开，否则保持只读'],
    ],
    bound: '受控',
    principleLabel: '设计原则',
    principle: '“只给模型完成任务所需的最小能力，而不是一个通用逃生口。”',
    securityEyebrow: '构造即安全',
    securityTitle: '安全由接口形态决定。',
    securityBody:
      'ServerFS 不依赖单一 sandbox 或单一网络假设。文件系统策略、传输校验、部署隔离和 Agent 边界相互加固。',
    securityStatement: '最小能力。显式边界。无环境权限。',
    guarantees: [
      '默认只读',
      '无 Shell 或通用执行器',
      'Workdir 边界约束',
      '基于 revision 的写入保护',
      '无递归删除',
      'Host / Origin 传输校验',
      '无公开 MCP 监听端口',
      'Agent Bridge 按需启用',
    ],
    agentEyebrow: '可选 AGENT BRIDGE',
    agentTitle: '原生 Agent 留在宿主机。',
    agentBody:
      '可选 Agent Bridge 仅适用于 Linux 部署；Windows v0.10 不包含 Agent Bridge。在 Linux 上，ServerFS 通过用户自有 Unix socket 转发结构化任务。Codex、Claude 和 Qoder 保留原生默认配置；v0.9 增加模型发现与单次任务覆盖，可选 Jev Advisors 还能在提交前给出模型建议，但不会获得执行权。',
    exploreAgent: '了解 Agent Bridge',
    exploreJev: '了解 Jev Advisors',
    mcpContainer: 'MCP 容器',
    hostService: '宿主机用户服务',
    advisoryOnly: '仅提供建议',
    policyDecides: '策略决定',
    quickStartBar: 'serverfs · 快速开始',
    selfHosted: '自托管',
    quickTitleLine1: '一个受控服务。',
    quickTitleLine2: '你的机器，你的策略。',
    quickBody:
      '从 11 个文件系统工具开始。Linux 和 Windows 均可按需增加二进制传输；隔离的 ChatGPT 文件入口、Agent Bridge 和宿主机 Jev Advisors 是可选的 Linux 部署能力。',
    readDeployment: '阅读部署指南',
    finalTitleLine1: '让 AI 理解你的服务器。',
    finalTitleLine2: '让边界始终清晰。',
    readDocs: '阅读文档',
    footer: '让 MCP 在 Linux 和 Windows 上安全访问你明确配置的 workdir。',
    footerDocs: '文档',
    footerSource: '源码',
    footerReleases: '版本',
  },
} as const;

const c = copy[locale];
const base = import.meta.env.BASE_URL;
const localePrefix = isZh ? 'zh-cn/' : '';
const local = (path = '') => `${base}${localePrefix}${path.replace(/^\/+/, '')}`;
const languageUrl = isZh ? base : `${base}zh-cn/`;
const canonicalUrl = isZh
  ? 'https://ntlx.github.io/ServerFS_MCP/zh-cn/'
  : 'https://ntlx.github.io/ServerFS_MCP/';
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#090b10" />
    <script is:inline>document.documentElement.classList.add('motion-ready');</script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href="https://ntlx.github.io/ServerFS_MCP/" />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href="https://ntlx.github.io/ServerFS_MCP/zh-cn/"
    />
    <link rel="alternate" hreflang="x-default" href="https://ntlx.github.io/ServerFS_MCP/" />
    <title>{c.title}</title>
  </head>
  <body>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href={local()} aria-label="ServerFS MCP home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ServerFS</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href={local('docs/')}>{c.nav.docs}</a>
        <a href="#architecture">{c.nav.architecture}</a>
        <a href="#security">{c.nav.security}</a>
        <a class="language-link" href={languageUrl} aria-label={c.languageLabel}>
          {c.languageSwitch}
        </a>
        <a
          class="github-link"
          href="https://github.com/NTLx/ServerFS_MCP"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <a
            class="release-pill"
            href="https://github.com/NTLx/ServerFS_MCP/releases/tag/v0.10.0"
            target="_blank"
            rel="noreferrer"
          >
            <span class="live-dot"></span>
            {c.release}
            <span aria-hidden="true">→</span>
          </a>

          <p class="eyebrow">{c.heroEyebrow}</p>
          <h1>
            {c.headline.map((line, index) => (
              <span class:list={['headline-line', { 'headline-muted': index > 0 }]}>{line}</span>
            ))}
          </h1>
          <p class="hero-lede">{c.lede}</p>

          <div class="hero-actions">
            <a class="button primary" href={local('docs/getting-started/')}>{c.getStarted}</a>
            <a
              class="button secondary"
              href="https://github.com/NTLx/ServerFS_MCP"
              target="_blank"
              rel="noreferrer"
            >
              {c.viewSource} <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="trust-line" aria-label="Core guarantees">
            {c.guaranteesShort.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="hero-system" data-system-stage data-system-step="0" aria-label="ServerFS architecture overview">
          <div class="system-grid" aria-hidden="true"></div>
          <div class="system-label top-label">{c.diagramLabel}</div>

          <div class="system-diagram">
            <div class="node" data-system-node="client">
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 7.5h14M5 12h14M5 16.5h9" /></svg>
              </span>
              <div><strong>ChatGPT</strong><small>{c.mcpClient}</small></div>
            </div>

            <div class="flow-line" data-system-flow="client-tunnel" aria-hidden="true"><span></span></div>

            <div class="node" data-system-node="tunnel">
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 8h10M14 5l3 3-3 3M17 16H7M10 13l-3 3 3 3" /></svg>
              </span>
              <div><strong>Secure MCP Tunnel</strong><small>{c.outboundOnly}</small></div>
            </div>

            <div class="flow-line" data-system-flow="tunnel-server" aria-hidden="true"><span></span></div>

            <div class="server-card" data-system-node="server">
              <div class="server-head">
                <span class="server-led"></span>
                <strong>ServerFS MCP</strong>
                <code>v0.10.0</code>
              </div>
              {c.serverRows.map(([label, detail]) => (
                <div class="server-row" data-policy-row><span>{label}</span><em>{detail}</em></div>
              ))}
            </div>

            <div class="branch-grid" aria-label="ServerFS capability boundaries">
              <div class="branch-card workdir-card" data-system-node="workdir">
                <div class="branch-title">
                  <span class="branch-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M5 6v7a4 4 0 0 0 4 4h10M15 13l4 4-4 4" /></svg>
                  </span>
                  <strong>{c.workdirs}</strong>
                </div>
                <code>/srv/projects</code>
                <small>{c.workdirDefault}</small>
              </div>

              <div class="branch-card agent-card" data-system-node="agent">
                <div class="branch-title">
                  <span class="branch-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 12h10M9 8l-4 4 4 4M15 8l4 4-4 4" /></svg>
                  </span>
                  <strong>Agent Bridge</strong>
                </div>
                <code>{c.userSocket}</code>
                <div class="branch-runtimes">
                  <span><i></i> Codex</span>
                  <span><i></i> Claude</span>
                  <span><i></i> Qoder</span>
                </div>
              </div>
            </div>

            <div class="system-footer">
              <span><i class="ok"></i> {c.internalNetwork}</span>
              <span><i class="ok"></i> {c.noPorts}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="capability-section shell" data-reveal aria-labelledby="capability-title">
        <div class="section-heading capability-heading" data-reveal-item>
          <p class="eyebrow">{c.capabilityEyebrow}</p>
          <h2 id="capability-title">{c.capabilityTitle}</h2>
          <p>{c.capabilityBody}</p>
        </div>

        <div class="capability-strip" data-reveal-item aria-label={c.surfacesLabel}>
        {c.surfaces.map((surface, index) => (
          <article class:list={['cap-card', { active: index === 3 }]}>
            <div class="cap-top">
              <strong>{surface.count}</strong>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h2>{surface.label}</h2>
            <p>{surface.detail}</p>
          </article>
        ))}
        </div>
      </section>

      <section class="section shell" id="architecture" data-reveal>
        <div class="section-heading" data-reveal-item>
          <p class="eyebrow">{c.architectureEyebrow}</p>
          <h2>{c.architectureTitle}</h2>
          <p>{c.architectureBody}</p>
        </div>

        <div class="architecture-layout" data-reveal-item>
          <div class="layer-stack">
            {c.layers.map(([number, title, detail]) => (
              <div class="layer-row">
                <span class="layer-number">{number}</span>
                <div><strong>{title}</strong><small>{detail}</small></div>
                <span class="layer-state">{c.bound}</span>
              </div>
            ))}
          </div>

          <aside class="principle-card">
            <p class="mini-label">{c.principleLabel}</p>
            <blockquote>{c.principle}</blockquote>
            <div class="principle-tags">
              <span>openat(2)</span>
              <span>O_NOFOLLOW</span>
              <span>atomic publish</span>
              <span>revision CAS</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section shell" id="security" data-reveal>
        <div class="section-heading split-heading" data-reveal-item>
          <div>
            <p class="eyebrow">{c.securityEyebrow}</p>
            <h2>{c.securityTitle}</h2>
          </div>
          <p>{c.securityBody}</p>
        </div>

        <div class="security-layout" data-reveal-item>
          <p class="security-statement">{c.securityStatement}</p>
          <div class="security-grid">
            {c.guarantees.map((item, index) => (
              <div class="security-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
                <i aria-hidden="true">✓</i>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section shell agent-section" data-reveal>
        <div class="agent-copy" data-reveal-item>
          <p class="eyebrow">{c.agentEyebrow}</p>
          <h2>{c.agentTitle}</h2>
          <p>{c.agentBody}</p>
          <a class="text-link" href={local('docs/agent-bridge/')}>
            {c.exploreAgent} <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={local('docs/jev-advisors/')}>
            {c.exploreJev} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="agent-diagram" data-reveal-item aria-label="Agent Bridge data path">
          <div class="agent-box muted-box">
            <small>{c.mcpContainer}</small>
            <strong>ServerFS</strong>
          </div>
          <div class="agent-link"><span></span><code>bridge.sock</code></div>
          <div class="agent-box bridge-box">
            <small>{c.hostService}</small>
            <strong>Agent Bridge</strong>
            <div class="runtime-list">
              <span><i></i> Codex</span>
              <span><i></i> Claude</span>
              <span><i></i> Qoder</span>
            </div>
            <div class="advisor-row">
              <span class="advisor-name">Jev</span>
              <span class="advisor-arrow" aria-hidden="true">→</span>
              <span>{c.advisoryOnly}</span>
            </div>
            <div class="policy-line">{c.policyDecides}</div>
          </div>
        </div>
      </section>

      <section class="section shell quickstart-section" data-reveal>
        <div class="terminal" data-reveal-item>
          <div class="terminal-bar">
            <span class="terminal-dots"><i></i><i></i><i></i></span>
            <span>{c.quickStartBar}</span>
            <span></span>
          </div>
          <pre><code><span class="prompt">$</span> git clone https://github.com/NTLx/ServerFS_MCP.git
<span class="prompt">$</span> cd ServerFS_MCP
<span class="prompt">$</span> cp .env.example .env
<span class="prompt">$</span> docker compose pull
<span class="prompt">$</span> docker compose up -d

<span class="success">✓ serverfs-mcp      healthy</span>
<span class="success">✓ openai-tunnel     connected</span></code></pre>
        </div>

        <div class="quickstart-copy" data-reveal-item>
          <p class="eyebrow">{c.selfHosted}</p>
          <h2>{c.quickTitleLine1}<br />{c.quickTitleLine2}</h2>
          <p>{c.quickBody}</p>
          <a class="button secondary" href={local('docs/getting-started/')}>{c.readDeployment}</a>
        </div>
      </section>

      <section class="final-cta shell" data-reveal>
        <div data-reveal-item>
          <p class="eyebrow">SERVERFS MCP</p>
          <h2>{c.finalTitleLine1}<br /><span>{c.finalTitleLine2}</span></h2>
        </div>
        <div class="cta-actions" data-reveal-item>
          <a class="button primary" href={local('docs/')}>{c.readDocs}</a>
          <a
            class="button secondary"
            href="https://github.com/NTLx/ServerFS_MCP"
            target="_blank"
            rel="noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <div class="brand footer-brand">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ServerFS</span>
      </div>
      <p>{c.footer}</p>
      <div>
        <a href={local('docs/')}>{c.footerDocs}</a>
        <a href="https://github.com/NTLx/ServerFS_MCP">{c.footerSource}</a>
        <a href="https://github.com/NTLx/ServerFS_MCP/releases">{c.footerReleases}</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const revealSections = document.querySelectorAll('[data-reveal]');
        const stage = document.querySelector('[data-system-stage]');

        const revealAll = () => {
          revealSections.forEach((section) => section.classList.add('is-visible'));
          stage?.classList.add('is-visible');
        };

        if (reducedMotion.matches) {
          revealAll();
          if (stage) stage.dataset.systemStep = '4';
          return;
        }

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries, instance) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                instance.unobserve(entry.target);
              }
            },
            { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
          );

          revealSections.forEach((section) => observer.observe(section));
        } else {
          revealSections.forEach((section) => section.classList.add('is-visible'));
        }

        if (!stage) return;

        requestAnimationFrame(() => stage.classList.add('is-visible'));

        let ticking = false;
        const updateSystemStage = () => {
          const rect = stage.getBoundingClientRect();
          const travel = window.innerHeight + rect.height;
          const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / travel));
          const step = Math.min(4, Math.floor(progress * 5));

          stage.style.setProperty('--system-progress', progress.toFixed(3));
          stage.dataset.systemStep = String(step);
          ticking = false;
        };

        const requestStageUpdate = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateSystemStage);
        };

        updateSystemStage();
        window.addEventListener('scroll', requestStageUpdate, { passive: true });
        window.addEventListener('resize', requestStageUpdate, { passive: true });
      })();
    </script>
  </body>
</html>
