    skillsTitle: '让运维知识随项目一起交付。',
    skillsBody:
      '当前版本提供 7 个面向任务的 Agent Skills，覆盖安装、配置、升级、诊断、OpenAI Tunnel、HTTP 认证以及 Agent Bridge/runtime 运维；Release 同时发布仅包含 Skills 的可移植 Plugin。',
    exploreSkills: '了解 Agent Skills',
    footer: '让 MCP 在 Linux、Windows 和 macOS 上安全访问你明确配置的 workdir。',
    footerDocs: '文档',
    footerSource: '源码',
    footerReleases: '版本',
  },
} as const;

const c = copy[locale];
const base = import.meta.env.BASE_URL;
const localePrefix = isZh ? 'zh-cn/' : '';
const local = (path = '') => `${base}${localePrefix}${path.replace(/^\/+/, '')}`;
const languageUrl = isZh ? base : `${base}zh-cn/`;
const canonicalUrl = isZh
  ? 'https://ntlx.github.io/ServerFS_MCP/zh-cn/'
  : 'https://ntlx.github.io/ServerFS_MCP/';
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#090b10" />
    <script is:inline>document.documentElement.classList.add('motion-ready');</script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href="https://ntlx.github.io/ServerFS_MCP/" />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href="https://ntlx.github.io/ServerFS_MCP/zh-cn/"
    />
    <link rel="alternate" hreflang="x-default" href="https://ntlx.github.io/ServerFS_MCP/" />
    <title>{c.title}</title>
  </head>
  <body>
    <div class="ambient ambient-a" aria-hidden="true"></div>
    <div class="ambient ambient-b" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href={local()} aria-label="ServerFS MCP home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ServerFS</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href={local('docs/')}>{c.nav.docs}</a>
        <a href="#connect">{c.nav.connect}</a>
        <a href="#architecture">{c.nav.architecture}</a>
        <a href="#security">{c.nav.security}</a>
        <a class="language-link" href={languageUrl} aria-label={c.languageLabel}>
          {c.languageSwitch}
        </a>
        <a
          class="github-link"
          href="https://github.com/NTLx/ServerFS_MCP"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <a
            class="release-pill"
            href="https://github.com/NTLx/ServerFS_MCP/releases/latest"
            target="_blank"
            rel="noreferrer"
          >
            <span class="live-dot"></span>
            {c.release}
            <span aria-hidden="true">→</span>
          </a>

          <p class="eyebrow">{c.heroEyebrow}</p>
          <h1>
            {c.headline.map((line, index) => (
              <span class:list={['headline-line', { 'headline-muted': index > 0 }]}>{line}</span>
            ))}
          </h1>
          <p class="hero-lede">{c.lede}</p>

          <div class="hero-actions">
            <a class="button primary" href={local('docs/getting-started/')}>{c.getStarted}</a>
            <a
              class="button secondary"
              href="https://github.com/NTLx/ServerFS_MCP"
              target="_blank"
              rel="noreferrer"
            >
              {c.viewSource} <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="trust-line" aria-label="Core guarantees">
            {c.guaranteesShort.map((item) => <span>{item}</span>)}
          </div>
        </div>

        <div class="hero-system" data-system-stage data-system-step="0" aria-label="ServerFS architecture overview">
          <div class="system-grid" aria-hidden="true"></div>
          <div class="system-label top-label">{c.diagramLabel}</div>

          <div class="system-diagram">
            <div class="node" data-system-node="client">
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 7.5h14M5 12h14M5 16.5h9" /></svg>
              </span>
              <div><strong>ChatGPT</strong><small>{c.mcpClient}</small></div>
            </div>

            <div class="flow-line" data-system-flow="client-tunnel" aria-hidden="true"><span></span></div>

            <div class="node" data-system-node="tunnel">
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 8h10M14 5l3 3-3 3M17 16H7M10 13l-3 3 3 3" /></svg>
              </span>
              <div><strong>Secure MCP Tunnel</strong><small>{c.outboundOnly}</small></div>
            </div>

            <div class="flow-line" data-system-flow="tunnel-server" aria-hidden="true"><span></span></div>

            <div class="server-card" data-system-node="server">
              <div class="server-head">
                <span class="server-led"></span>
                <strong>ServerFS MCP</strong>
                <code>{c.release}</code>
              </div>
              {c.serverRows.map(([label, detail]) => (
                <div class="server-row" data-policy-row><span>{label}</span><em>{detail}</em></div>
              ))}
            </div>

            <div class="branch-grid" aria-label="ServerFS capability boundaries">
              <div class="branch-card workdir-card" data-system-node="workdir">
                <div class="branch-title">
                  <span class="branch-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M5 6v7a4 4 0 0 0 4 4h10M15 13l4 4-4 4" /></svg>
                  </span>
                  <strong>{c.workdirs}</strong>
                </div>
                <code>/srv/projects</code>
                <small>{c.workdirDefault}</small>
              </div>

              <div class="branch-card agent-card" data-system-node="agent">
                <div class="branch-title">
                  <span class="branch-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 12h10M9 8l-4 4 4 4M15 8l4 4-4 4" /></svg>
                  </span>
                  <strong>Agent Bridge</strong>
                </div>
                <code>{c.userSocket}</code>
                <div class="branch-runtimes">
                  <span><i></i> Codex</span>
                  <span><i></i> Claude</span>
                  <span><i></i> Qoder</span>
                  <span><i></i> ACP</span>
                </div>
              </div>
            </div>

            <div class="system-footer">
              <span><i class="ok"></i> {c.internalNetwork}</span>
              <span><i class="ok"></i> {c.noPorts}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section shell connect-section" id="connect" data-reveal>
        <div class="section-heading split-heading" data-reveal-item>
          <div>
            <p class="eyebrow">{c.connectEyebrow}</p>
            <h2>{c.connectTitle}</h2>
          </div>
          <p>{c.connectBody}</p>
        </div>

        <div class="connection-grid" data-reveal-item>
          {c.connectionModes.map(([name, label, detail]) => (
            <article class="connection-card">
              <code>{name}</code>
              <h3>{label}</h3>
              <p>{detail}</p>
            </article>
          ))}
        </div>
        <div class="connection-links" data-reveal-item>
          <a class="text-link" href={local('docs/getting-started/')}>{c.exploreHttp} <span aria-hidden="true">→</span></a>
          <a class="text-link" href={local('docs/api-key/')}>{c.exploreApiKey} <span aria-hidden="true">→</span></a>
          <a class="text-link" href={local('docs/oauth/')}>{c.exploreOAuth} <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="capability-section shell" data-reveal aria-labelledby="capability-title">
        <div class="section-heading capability-heading" data-reveal-item>
          <p class="eyebrow">{c.capabilityEyebrow}</p>
          <h2 id="capability-title">{c.capabilityTitle}</h2>
          <p>{c.capabilityBody}</p>
        </div>

        <div class="capability-strip" data-reveal-item aria-label={c.surfacesLabel}>
        {c.surfaces.map((surface, index) => (
          <article class:list={['cap-card', { active: index === c.surfaces.length - 1 }]}>
            <div class="cap-top">
              <strong>{surface.count}</strong>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h2>{surface.label}</h2>
            <p>{surface.detail}</p>
          </article>
        ))}
        </div>
      </section>

      <section class="platform-section" id="platforms">
        <div class="platform-intro shell" data-reveal>
          <div class="platform-heading" data-reveal-item>
            <div>
              <p class="eyebrow">{c.platformEyebrow}</p>
              <h2>{c.platformTitle}</h2>
            </div>
            <p>{c.platformBody}</p>
          </div>
        </div>

        <div class="platform-scroll" data-platform-section>
          <div class="platform-sticky shell" data-platform-sticky>
            <div class="platform-tabs" role="tablist" aria-label="ServerFS deployment platforms" data-platform-tabs>
              {c.platforms.map((platform, index) => (
                <button
                  type="button"
                  class:list={['platform-tab', { active: index === 0 }]}
                  role="tab"
                  id={`platform-tab-${platform.id}`}
                  aria-controls={`platform-panel-${platform.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  data-platform-tab={index}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {platform.name}
                </button>
              ))}
            </div>

            <div class="platform-viewport" data-platform-viewport>
              <div class="platform-track" data-platform-track>
                {c.platforms.map((platform, index) => (
                  <article
                    class="platform-panel"
                    id={`platform-panel-${platform.id}`}
                    role="tabpanel"
                    aria-labelledby={`platform-tab-${platform.id}`}
                    data-platform-panel={index}
                  >
                    <div class="platform-panel-copy">
                      <p class="mini-label">{platform.kicker}</p>
                      <h3>{platform.title}</h3>
                      <p>{platform.body}</p>
                      <a class="text-link" href={local(platform.href)}>
                        {platform.cta} <span aria-hidden="true">→</span>
                      </a>
                    </div>

                    <div class="platform-spec">
                      <div class="platform-architecture">
                        <div class="platform-architecture-head">
                          <span>{c.platformPathLabel}</span>
                          <strong>{platform.name}</strong>
                        </div>

                        <div class="platform-path" aria-label={`${platform.name} native execution path`}>
                          {platform.path.map(([number, label, title, detail], nodeIndex) => (
                            <div class="platform-path-step">
                              <div class="platform-path-node">
                                <div class="platform-path-meta"><span>{number}</span><small>{label}</small></div>
                                <strong>{title}</strong>
                                <p>{detail}</p>
                              </div>
                              {nodeIndex < platform.path.length - 1 && <span class="platform-path-arrow" aria-hidden="true">→</span>}
                            </div>
                          ))}
                        </div>

                        <div class="platform-value">
                          <span class="platform-value-label">{c.platformWhyLabel}</span>
                          <div class="platform-insights">
                            {platform.insights.map(([title, detail]) => (
                              <div class="platform-insight"><strong>{title}</strong><p>{detail}</p></div>
                            ))}
                          </div>
                        </div>
                      </div>

                      <div class="platform-terminal" aria-label={`${platform.name} command example`}>
                        <div class="terminal-bar">
                          <span class="terminal-dots"><i></i><i></i><i></i></span>
                          <span>{platform.name.toLowerCase()} · serverfs</span>
                          <span></span>
                        </div>
                        <pre><code>{platform.commands.map((command) => <><span class="prompt">$</span> {command}{'\n'}</>)}</code></pre>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            <div class="platform-progress" aria-hidden="true">
              <span data-platform-progress></span>
              <small>{c.platformScrollHint}</small>
            </div>
          </div>
        </div>
      </section>

      <section class="section shell" id="architecture" data-reveal>
        <div class="section-heading" data-reveal-item>
          <p class="eyebrow">{c.architectureEyebrow}</p>
          <h2>{c.architectureTitle}</h2>
          <p>{c.architectureBody}</p>
        </div>

        <div class="architecture-layout" data-reveal-item>
          <div class="layer-stack">
            {c.layers.map(([number, title, detail]) => (
              <div class="layer-row">
                <span class="layer-number">{number}</span>
                <div><strong>{title}</strong><small>{detail}</small></div>
                <span class="layer-state">{c.bound}</span>
              </div>
            ))}
          </div>

          <aside class="principle-card">
            <p class="mini-label">{c.principleLabel}</p>
            <blockquote>{c.principle}</blockquote>
            <div class="principle-tags">
              <span>openat(2)</span>
              <span>O_NOFOLLOW</span>
              <span>atomic publish</span>
              <span>revision CAS</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="section shell" id="security" data-reveal>
        <div class="section-heading split-heading" data-reveal-item>
          <div>
            <p class="eyebrow">{c.securityEyebrow}</p>
            <h2>{c.securityTitle}</h2>
          </div>
          <p>{c.securityBody}</p>
        </div>

        <div class="security-layout" data-reveal-item>
          <p class="security-statement">{c.securityStatement}</p>
          <div class="security-grid">
            {c.guarantees.map((item, index) => (
              <div class="security-item">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{item}</p>
                <i aria-hidden="true">✓</i>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section shell agent-section" data-reveal>
        <div class="agent-copy" data-reveal-item>
          <p class="eyebrow">{c.agentEyebrow}</p>
          <h2>{c.agentTitle}</h2>
          <p>{c.agentBody}</p>
          <a class="text-link" href={local('docs/agent-bridge/')}>
            {c.exploreAgent} <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={local('docs/acp/')}>
            {c.exploreAcp} <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={local('docs/jev-advisors/')}>
            {c.exploreJev} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="agent-diagram" data-reveal-item aria-label="Agent Bridge data path">
          <div class="agent-box muted-box">
            <small>{c.mcpContainer}</small>
            <strong>ServerFS</strong>
          </div>
          <div class="agent-link"><span></span><code>bridge.sock</code></div>
          <div class="agent-box bridge-box">
            <small>{c.hostService}</small>
            <strong>Agent Bridge</strong>
            <div class="runtime-list">
              <span><i></i> Codex</span>
              <span><i></i> Claude</span>
              <span><i></i> Qoder</span>
              <span><i></i> ACP</span>
            </div>
            <div class="advisor-row">
              <span class="advisor-name">Jev</span>
              <span class="advisor-arrow" aria-hidden="true">→</span>
              <span>{c.advisoryOnly}</span>
            </div>
            <div class="policy-line">{c.policyDecides}</div>
          </div>
        </div>
      </section>

      <section class="section shell quickstart-section" data-reveal>
        <div class="terminal" data-reveal-item>
          <div class="terminal-bar">
            <span class="terminal-dots"><i></i><i></i><i></i></span>
            <span>{c.quickStartBar}</span>
            <span></span>
          </div>
          <pre><code><span class="prompt">$</span> git clone https://github.com/NTLx/ServerFS_MCP.git
<span class="prompt">$</span> cd ServerFS_MCP
<span class="prompt">$</span> cp .env.example .env
<span class="prompt">$</span> docker compose pull
<span class="prompt">$</span> docker compose -f compose.yml -f compose.http.yml up -d serverfs-mcp
<span class="prompt">$</span> docker compose -f compose.yml -f compose.http.yml ps

<span class="success">✓ serverfs-mcp      healthy</span>
<span class="success">✓ http://127.0.0.1:8000/mcp</span></code></pre>
        </div>

        <div class="quickstart-copy" data-reveal-item>
          <p class="eyebrow">{c.selfHosted}</p>
          <h2>{c.quickTitleLine1}<br />{c.quickTitleLine2}</h2>
          <p>{c.quickBody}</p>
          <a class="button secondary" href={local('docs/getting-started/')}>{c.readDeployment}</a>
        </div>
      </section>

      <section class="section shell skills-section" data-reveal>
        <div class="section-heading split-heading" data-reveal-item>
          <div>
            <p class="eyebrow">{c.skillsEyebrow}</p>
            <h2>{c.skillsTitle}</h2>
          </div>
          <div>
            <p>{c.skillsBody}</p>
            <a class="text-link" href={local('docs/agent-skills/')}>{c.exploreSkills} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="final-cta shell" data-reveal>
        <div data-reveal-item>
          <p class="eyebrow">SERVERFS MCP</p>
          <h2>{c.finalTitleLine1}<br /><span>{c.finalTitleLine2}</span></h2>
        </div>
        <div class="cta-actions" data-reveal-item>
          <a class="button primary" href={local('docs/')}>{c.readDocs}</a>
          <a
            class="button secondary"
            href="https://github.com/NTLx/ServerFS_MCP"
            target="_blank"
            rel="noreferrer"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <div class="brand footer-brand">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>ServerFS</span>
      </div>
      <p>{c.footer}</p>
      <div>
        <a href={local('docs/')}>{c.footerDocs}</a>
        <a href="https://github.com/NTLx/ServerFS_MCP">{c.footerSource}</a>
        <a href="https://github.com/NTLx/ServerFS_MCP/releases">{c.footerReleases}</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const revealSections = document.querySelectorAll('[data-reveal]');
        const stage = document.querySelector('[data-system-stage]');
        const platformSection = document.querySelector('[data-platform-section]');
        const platformViewport = document.querySelector('[data-platform-viewport]');
        const platformTrack = document.querySelector('[data-platform-track]');
        const platformTabs = [...document.querySelectorAll('[data-platform-tab]')];
        const platformPanels = [...document.querySelectorAll('[data-platform-panel]')];
        const platformProgress = document.querySelector('[data-platform-progress]');

        const revealAll = () => {
          revealSections.forEach((section) => section.classList.add('is-visible'));
          stage?.classList.add('is-visible');
        };

        const setActivePlatform = (index) => {
          platformTabs.forEach((tab, tabIndex) => {
            const active = tabIndex === index;
            tab.classList.toggle('active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
            tab.tabIndex = active ? 0 : -1;
          });
          platformPanels.forEach((panel, panelIndex) => panel.classList.toggle('active', panelIndex === index));
        };

        if (reducedMotion.matches) {
          revealAll();
          if (stage) stage.dataset.systemStep = '4';
          setActivePlatform(0);
          return;
        }

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries, instance) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                instance.unobserve(entry.target);
              }
            },
            { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
          );

          revealSections.forEach((section) => observer.observe(section));
        } else {
          revealSections.forEach((section) => section.classList.add('is-visible'));
        }

        let stageTicking = false;
        const updateSystemStage = () => {
          if (!stage) return;
          const rect = stage.getBoundingClientRect();
          const travel = window.innerHeight + rect.height;
          const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / travel));
          const step = Math.min(4, Math.floor(progress * 5));

          stage.style.setProperty('--system-progress', progress.toFixed(3));
          stage.dataset.systemStep = String(step);
          stageTicking = false;
        };

        const requestStageUpdate = () => {
          if (!stage || stageTicking) return;
          stageTicking = true;
          requestAnimationFrame(updateSystemStage);
        };

        let platformTicking = false;
        const updatePlatformStage = () => {
          if (!platformSection || !platformViewport || !platformTrack || platformPanels.length < 2) return;
          const rect = platformSection.getBoundingClientRect();
          const travel = Math.max(1, platformSection.offsetHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, -rect.top / travel));
          const maxShift = Math.max(0, platformTrack.scrollWidth - platformViewport.clientWidth);
          const index = Math.min(platformPanels.length - 1, Math.round(progress * (platformPanels.length - 1)));

          platformTrack.style.transform = `translate3d(${-progress * maxShift}px, 0, 0)`;
          if (platformProgress) platformProgress.style.transform = `scaleX(${progress})`;
          setActivePlatform(index);
          platformTicking = false;
        };

        const requestPlatformUpdate = () => {
          if (!platformSection || platformTicking) return;
          platformTicking = true;
          requestAnimationFrame(updatePlatformStage);
        };

        platformTabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            if (!platformSection || platformPanels.length < 2) return;
            const sectionTop = window.scrollY + platformSection.getBoundingClientRect().top;
            const travel = Math.max(1, platformSection.offsetHeight - window.innerHeight);
            const target = sectionTop + (index / (platformPanels.length - 1)) * travel;
            window.scrollTo({ top: target, behavior: 'smooth' });
          });

          tab.addEventListener('keydown', (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            let next = index;
            if (event.key === 'ArrowLeft') next = Math.max(0, index - 1);
            if (event.key === 'ArrowRight') next = Math.min(platformTabs.length - 1, index + 1);
            if (event.key === 'Home') next = 0;
            if (event.key === 'End') next = platformTabs.length - 1;
            platformTabs[next]?.click();
            platformTabs[next]?.focus({ preventScroll: true });
          });
        });

        requestAnimationFrame(() => stage?.classList.add('is-visible'));
        updateSystemStage();
        updatePlatformStage();
        window.addEventListener('scroll', requestStageUpdate, { passive: true });
        window.addEventListener('scroll', requestPlatformUpdate, { passive: true });
        window.addEventListener('resize', requestStageUpdate, { passive: true });
        window.addEventListener('resize', requestPlatformUpdate, { passive: true });
      })();
    </script>
  </body>
</html>
