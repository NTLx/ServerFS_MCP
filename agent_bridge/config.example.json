{
  "socket_path": "/tmp/serverfs-agent-bridge/bridge.sock",
  "state_dir": "/tmp/serverfs-agent-bridge/state",
  "lock_dir": "/tmp/serverfs-agent-bridge/locks",
  "allowed_peer_uid": null,
  "allowed_peer_gid": null,
  "enable_fake_runtime": true,
  "codex": {
    "enabled": false,
    "autostart": false,
    "codex_home": "~/.codex",
    "codex_bin": "codex",
    "request_timeout_seconds": 10,
    "event_idle_timeout_seconds": null,
    "max_message_bytes": 134217728
  },
  "claude": {
    "enabled": false,
    "claude_bin": "claude",
    "probe_timeout_seconds": 5,
    "event_idle_timeout_seconds": null
  },
  "workdirs": [
    {
      "slot": 1,
      "alias": "scratch",
      "host_path": "/tmp/serverfs-agent-bridge/workdir",
      "read_only": false,
      "agent_mode": "workspace-write",
      "agent_runtimes": ["fake"]
    }
  ]
}
